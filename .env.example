# Public build-time configuration; never use a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after applying the database migrations and reviewing Auth settings.
NEXT_PUBLIC_SUPABASE_AUTH_ENABLED=false
# Public read-only keys for the profile shelf. They travel to the browser, so use
# the read keys, never a secret. Without them the picker falls back to a short
# built-in list; music needs no key.
NEXT_PUBLIC_TMDB_KEY=
# OMDb movie search and posters. Keep this key in local environment variables.
NEXT_PUBLIC_OMDB_KEY=
NEXT_PUBLIC_RAWG_KEY=
# TVMaze no exige clave para su buscador; si tu cuenta/proxy te da una, puedes
# dejarla aquí. Nunca uses una clave secreta en el código fuente.
NEXT_PUBLIC_TVMAZE_KEY=
# IGDB is the preferred games catalogue. These values are short-lived public
# client credentials only; keep the Twitch client secret out of the browser.
NEXT_PUBLIC_IGDB_CLIENT_ID=
NEXT_PUBLIC_IGDB_ACCESS_TOKEN=
# Optional short-lived Spotify bearer token. MusicBrainz works without a key.
NEXT_PUBLIC_SPOTIFY_ACCESS_TOKEN=

# Server-only Resend configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_NAME=Entreclase
RESEND_FROM_EMAIL=hola@entreclases.com
RESEND_REPLY_TO=hola@entreclases.com
RESEND_INVITES_FROM_EMAIL=invitaciones@entreclases.com
RESEND_NOTIFICATIONS_FROM_EMAIL=avisos@entreclases.com
RESEND_SECURITY_FROM_EMAIL=seguridad@entreclases.com

# Identificación pública del titular. No inventar estos datos.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=

LEGAL_CONTROLLER_TAX_ID=
# Indicar datos registrales o «No procede» cuando se haya confirmado.
LEGAL_CONTROLLER_REGISTRY=
# Solo si existe un DPD designado; no inventar nombramientos.
LEGAL_DPO_CONTACT=
# Texto público: entidades, región, transferencias/garantías y cómo obtener copia.
LEGAL_PROVIDER_DETAILS=
# Texto público: plazos reales de registros, copias y conservación tras baja.
LEGAL_RETENTION_DETAILS=
# Cambiar solo tras revisión del titular y comprobación de implementación.
LEGAL_REVIEW_COMPLETED=false

# Prelanzamiento: solo activar al aprobar la apertura y preparar Supabase.
# Aunque sea true, el cliente espera al 28/09/2026 00:00 Europe/Madrid.
NEXT_PUBLIC_LAUNCH_OPEN=false
